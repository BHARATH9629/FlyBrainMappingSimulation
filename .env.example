# ==============================================================
# FlyBrainMappingSimulation (ConnectomeLab) - Environment Config
# ==============================================================
# Copy this file to .env and fill in your confidential keys.
# .env is ignored by Git to prevent leaking sensitive information.

# --- LLM Attacker & Defender API Keys ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- External Brain / Connectome API Credentials ---
CAVE_API_TOKEN=your_cave_auth_token_here
FLYWIRE_SECRET=your_flywire_secret_here

# --- Database Credentials (if using custom DB for experiments) ---
DB_DIALECT=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flybrain_db
DB_USER=fly_user
DB_PASSWORD=your_secure_password_here

# --- Simulation & Visualization Flags ---
LIVE_PROFILE=0
SDL_VIDEO_CENTERED=1
